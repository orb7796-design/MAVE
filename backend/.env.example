# --- environment: "production" enforces strong secrets and disables demo data/answers ---
MAVE_ENV=development
# --- required in production (>= 32 / >= 16 random characters; the app refuses to start otherwise) ---
MAVE_JWT_SECRET=change-me-to-a-long-random-string
MAVE_ADMIN_KEY=change-me-too
# --- providers (in production they MUST be set; in development empty = demo data/answers) ---
# Web search: base URL of a SearXNG instance with the JSON format enabled (ops/searxng/settings.yml). docker compose sets it for you.
# Local run without compose: SEARXNG_URL=http://localhost:8081
SEARXNG_URL=
# AI answers: xAI Grok is used when XAI_API_KEY is set, otherwise Anthropic when ANTHROPIC_API_KEY is set.
# MAVE_AI_PROVIDER=xai|anthropic forces one of them (auto = pick by key).
XAI_API_KEY=
MAVE_XAI_MODEL=grok-4.6
MAVE_AI_PROVIDER=auto
ANTHROPIC_API_KEY=
MAVE_MODEL=claude-sonnet-5-5
# --- web / ops ---
# --- database: PostgreSQL (docker compose sets this itself; required in production) ---
# MAVE_DATABASE_URL=postgresql://mave:mave@localhost:5432/mave
# MAVE_DB_POOL_SIZE=10   # max connections per API process
MAVE_RATE_LIMIT=90
MAVE_AUTH_RATE_LIMIT=10
# Optional: share rate limits and the web-search/AI-answer cache between all workers/replicas (recommended in production). Without it each process works alone.
# docker-compose.prod.yml sets this itself.  MAVE_REDIS_URL=redis://localhost:6379/0
MAVE_REDIS_URL=
MAVE_TRUST_PROXY=0
# --- sessions: access token lifetime (s) and sliding refresh-token lifetime (s); sessions never exceed 90 days ---
MAVE_ACCESS_TTL=900
MAVE_REFRESH_TTL=2592000
# --- e-mail for password reset / verification (without SMTP: dev logs the mail, production sends nothing) ---
MAVE_SMTP_HOST=
MAVE_SMTP_PORT=587
MAVE_SMTP_USER=
MAVE_SMTP_PASSWORD=
MAVE_SMTP_FROM=no-reply@yourdomain.org
# public web-app URL used for the links inside those e-mails (code is always included too).
# The bundled web app uses hash routes, so end it with /web/#  ->  https://search.yourdomain.org/web/#
MAVE_PUBLIC_URL=
# comma-separated browser origins allowed to call the API (web app), e.g. https://app.yourdomain.org
MAVE_CORS_ORIGINS=
# public page that describes your crawler (sent in the User-Agent)
MAVE_BOT_URL=
# --- logging: json (default in production) or text; one JSON object per line on stdout for log collectors ---
MAVE_LOG_FORMAT=
